APP_NAME=Kondomanager
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=it
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# Worker per hosting condivisi senza Supervisor/cron persistente (cPanel, Altervista, Netsons).
# false = corretto qui: l'installazione manuale richiede accesso CLI, quindi hai anche cron nativo
# e un queue:work dedicato (Supervisor). true è il default solo per il pacchetto distribuito
# su hosting condivisi senza CLI — vedi config/app.php per i dettagli.
SCHEDULE_QUEUE_WORKER=false

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=laravel
DB_USERNAME=root
DB_PASSWORD=

# Database advanced configuration, only change if necessary
# Esempio: MySQL 5.5 o precedenti senza supporto utf8mb4/InnoDB
# DB_CHARSET=utf8      
# DB_COLLATION=utf8_unicode_ci  
# DB_ENGINE=InnoDB

# Proxy fidati. Serve dietro un reverse proxy — hosting condiviso, Docker/Coolify, oppure
# nginx/apache davanti a php-fpm — perché Laravel riconosca https e l'indirizzo IP reale di
# chi visita. Senza, tutti i visitatori risultano avere l'indirizzo del proxy.
#
# PRIVATE_SUBNETS si fida solo di un proxy che si connette da rete privata o loopback (incluse
# le reti Docker e la CGNAT 100.64/10): da internet non è falsificabile, perché chi arriva da
# fuori ha un indirizzo pubblico. È quindi innocuo anche dove un proxy non c'è affatto.
#
# ⚠️ Non usare '*': si fida di chiunque si connetta, e dove l'origine è raggiungibile fuori dal
# proxy permette di falsificare il proprio IP e di aggirare il blocco dei tentativi di accesso
# e del codice a due fattori. Se il tuo proxy ha un indirizzo pubblico, scrivi qui la sua lista
# esplicita di IP.
#
# Resta commentata qui perché questo file è per chi sviluppa, e in locale non serve. Nel
# pacchetto con l'installazione guidata la attiva lo script di build.
# TRUSTED_PROXIES=PRIVATE_SUBNETS

# Backup automatici. Il valore predefinito, se la riga manca, è ATTIVO: si scommenta solo per
# spegnerli — sul server dimostrativo, o dove i backup li fa l'infrastruttura (SaaS gestito).
# BACKUP_ENABLED=true

# Modalità dimostrativa: l'interfaccia mostra gli avvisi da vetrina e alcune azioni sono
# inibite. Da tenere spenta ovunque tranne che sul server delle prove.
# IS_DEMO=false

SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=file
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
